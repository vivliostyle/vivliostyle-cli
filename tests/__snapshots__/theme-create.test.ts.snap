  "/work/my-theme/theme.css": "/*
 * My Theme
 * A theme for testing
 *
 * This theme is built on @vivliostyle/theme-base: it imports the base styles
 * and the feature modules, then adjusts them through CSS custom properties.
 * Every variable below is optional. Change the values, remove the ones you do
 * not need, and add your own rules at the end of this file.
 *
 * Available modules and variables:
 * https://github.com/vivliostyle/themes/tree/main/packages/%40vivliostyle/theme-base
 */

/* Base styles: CSS reset, variable defaults, and basic HTML elements */
@import '@vivliostyle/theme-base';

/* Feature modules: keep the ones your theme supports */
@import '@vivliostyle/theme-base/page';
@import '@vivliostyle/theme-base/section';
@import '@vivliostyle/theme-base/toc';
@import '@vivliostyle/theme-base/figure';
@import '@vivliostyle/theme-base/table';
@import '@vivliostyle/theme-base/listing';
@import '@vivliostyle/theme-base/equation';
@import '@vivliostyle/theme-base/math';
@import '@vivliostyle/theme-base/footnote';
@import '@vivliostyle/theme-base/endnote';
@import '@vivliostyle/theme-base/sidenote';
@import '@vivliostyle/theme-base/citation';
@import '@vivliostyle/theme-base/theorem';
@import '@vivliostyle/theme-base/appendix';

/* Syntax highlighting for code blocks */
@import '@vivliostyle/theme-base/prism';
@import '@vivliostyle/theme-base/prism/theme-prism';

:root {
  /* Typography */
  --vs-font-family: 'Georgia', 'Hiragino Mincho ProN', 'Yu Mincho', serif;
  --vs-font-family-alt: 'Helvetica Neue', 'Hiragino Sans', 'Yu Gothic', sans-serif;
  --vs-font-family-monospace: 'Menlo', 'Consolas', monospace;
  --vs-font-size: 10.5pt;
  --vs-line-height: 1.7;
  --vs-widows-orphans: 2;

  /* Colors */
  --vs-color-foreground: #1a1a1a;
  --vs-color-foreground-alt: #555;
  --vs-color-background-alt: #f3f3f0;
  --vs-color-border: #b8b8b8;

  /* Headings */
  --vs--heading-font-family: var(--vs-font-family-alt);
  --vs--heading-line-height: 1.3;
  --vs--h1-font-size: 2em;
  --vs--h1-padding-block: 0 0.25em;
  --vs--h1-border-width-block-end: 1px;
  --vs--h1-border-style-block-end: solid;
  --vs--h2-font-size: 1.5em;
  --vs--h3-font-size: 1.2em;
  --vs--h4-font-size: 1em;

  /* Paragraphs: indent the first line instead of leaving a gap */
  --vs--p-text-indent: 1em;
  --vs--p-margin-block: 0;

  /* Figures, tables, and code */
  --vs--figcaption-font-family: var(--vs-font-family-alt);
  --vs--figcaption-font-size: 0.9em;
  --vs--figcaption-text-color: var(--vs-color-foreground-alt);
  --vs--table-font-family: var(--vs-font-family-alt);
  --vs--th-background-color: var(--vs-color-background-alt);
  --vs--pre-font-size: 0.85em;
  --vs-prism--block-code-padding: 0.75em 1em;

  /* Section numbering: enable it for reports and technical books */
  /* --vs-section--marker-display: inline; */

  /* Table of contents */
  --vs-toc--page-leader-content: leader(dotted) ' ';

  /* Pages: margins and running heads (page numbers on the outer edge) */
  --vs-page--margin-top: 22mm;
  --vs-page--margin-bottom: 22mm;
  --vs-page--margin-inside: 20mm;
  --vs-page--margin-outside: 16mm;
  --vs-page--mbox-top-outside-content: env(doc-title);
  --vs-page--mbox-bottom-outside-content: counter(page);
  --vs-page--mbox-font-size: 0.85em;
  --vs-page--mbox-text-color: var(--vs-color-foreground-alt);
}

/* Styles that only apply to the web version */
@media screen {
  :root {
    --vs--anchor-text-color: #0b6bcb;
  }
}

/* Add your own rules below */
",
  "/work/my-theme/vivliostyle.config.js": "// @ts-check
import { defineConfig } from '@vivliostyle/cli';

export default defineConfig({
  title: \\"My Theme Example\\",
  author: \\"Theme Author\\",
  language: \\"en\\",
  size: \\"A5\\",
  theme: \\".\\",
  image: \\"ghcr.io/vivliostyle/cli:0.0.1\\",
  entry: [
    { rel: \\"contents\\" },
    \\"example/01_typography.md\\",
    \\"example/02_figures-and-tables.md\\",
    \\"example/03_code-and-math.md\\",
  ],
  toc: {
    sectionDepth: 2,
  },
  workspaceDir: \\".vivliostyle\\",
  output: [
    \\"dist/example.pdf\\",
    {
      path: \\"dist/example\\",
      format: \\"webpub\\",
    },
  ],
});
",
}
